@PACKAGE_INIT@

# LingmoSDKTargets.cmake exports the toolkit's libraries as Lingmo::SDK and
# Lingmo::SDKBase, the EXPORT_NAMEs of lingmo-sdk and lingmo-sdk-base, which
# is what downstream CMakeLists link.
include("${CMAKE_CURRENT_LIST_DIR}/LingmoSDKTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/LingmoTranslations.cmake")

check_required_components(LingmoSDK)
