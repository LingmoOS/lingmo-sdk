@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/LingmoSDKTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/LingmoTranslations.cmake")

# LingmoSDKTargets.cmake exports targets as Lingmo::lingmo-sdk and
# Lingmo::lingmo-sdk-base (NAMESPACE Lingmo::). Provide the canonical
# short aliases that downstream CMakeLists use.
if(TARGET Lingmo::lingmo-sdk AND NOT TARGET Lingmo::SDK)
    add_library(Lingmo::SDK ALIAS Lingmo::lingmo-sdk)
endif()
if(TARGET Lingmo::lingmo-sdk-base AND NOT TARGET Lingmo::SDKBase)
    add_library(Lingmo::SDKBase ALIAS Lingmo::lingmo-sdk-base)
endif()
if(TARGET Lingmo::lingmo-sdk-base AND NOT TARGET Lingmo::ToolkitBase)
    add_library(Lingmo::ToolkitBase ALIAS Lingmo::lingmo-sdk-base)
endif()

check_required_components(LingmoSDK)
